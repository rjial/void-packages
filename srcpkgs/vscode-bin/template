# Template file for 'vscode-bin'
pkgname=vscode-bin
version=1.139.1
revision=1
archs="x86_64 aarch64"
depends="alsa-lib gtk+3 gnupg libnotify libsecret libxkbfile libXScrnSaver
 lsof nss shared-mime-info xdg-utils hicolor-icon-theme desktop-file-utils"
short_desc="Visual Studio Code (official binary build)"
maintainer="Rizal Abdul Basith <rizalabdulbasith@maxxitani.id>"
license="custom:Proprietary"
homepage="https://code.visualstudio.com/"
nopie=yes
nostrip=yes
noshlibprovides=yes
restricted=yes
repository=nonfree

case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="https://update.code.visualstudio.com/${version}/linux-x64/stable>vscode-bin-${version}_x64.tar.gz"
	checksum=0c9cbcea070e9a0fc62de5c78fee01a80f8e32f78ada664d9731f6c517503b7e
	;;
aarch64)
	distfiles="https://update.code.visualstudio.com/${version}/linux-arm64/stable>vscode-bin-${version}_arm64.tar.gz"
	checksum=d52334ecd0c7aa6b1b4bf3c3bdf16530a04bce013c95f106d372f65e0f6e5bc5
	;;
esac

do_install() {
	vmkdir usr/lib/vscode-bin
	vcopy '*' usr/lib/vscode-bin

	vmkdir usr/bin
	ln -sfr "${DESTDIR}/usr/lib/vscode-bin/bin/code" "${DESTDIR}/usr/bin/code"

	vinstall "${FILESDIR}/code.desktop" 644 usr/share/applications

	vmkdir usr/share/pixmaps
	ln -sfr "${DESTDIR}/usr/lib/vscode-bin/resources/app/resources/linux/code.png" \
		"${DESTDIR}/usr/share/pixmaps/code.png"

	vlicense resources/app/LICENSE.rtf
}
