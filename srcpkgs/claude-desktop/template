# Template file for 'claude-desktop'
pkgname=claude-desktop
version=2.7032.0
revision=1
archs="x86_64 aarch64"
depends="libnotify xdg-utils at-spi2-core libuuid libsecret hicolor-icon-theme
 desktop-file-utils xdg-desktop-portal xdg-desktop-portal-gtk socat
 libcap-ng libseccomp"
depends_x86_64="qemu-system-amd64 edk2-ovmf"
depends_aarch64="qemu-system-aarch64 edk2-ovmf"
short_desc="Official Claude AI desktop app from Anthropic"
maintainer="Rizal Abdul Basith <rizalabdulbasith@maxxitani.id>"
license="custom:Proprietary"
homepage="https://claude.com/download"
changelog="https://claude.ai/download"
nopie=yes
nostrip=yes
noshlibprovides=yes
restricted=yes
repository=nonfree

_baseurl="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop"
case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="${_baseurl}/claude-desktop_${version}_amd64.deb"
	checksum=1e7f4504bca5b2f6b2d3c4123d145d727647e77f2ee2d046850711e61e7d7b11
	;;
aarch64)
	distfiles="${_baseurl}/claude-desktop_${version}_arm64.deb"
	checksum=6dca79fa4c8b65267780b5460c627159852e2dfa2ad011d03a0488f7bf226ec3
	;;
esac

do_install() {
	local size

	# the .deb's data.tar has a single top-level "usr" directory, which
	# xbps-src's extractor strips away, so source paths below have no
	# leading "usr/"
	vmkdir usr/lib/claude-desktop
	vcopy 'lib/claude-desktop/*' usr/lib/claude-desktop

	# Upstream's /usr/bin/claude-desktop is a bare symlink to the Electron
	# binary, which leaves Electron on its X11 default (blurry under a
	# scaled Wayland session). Replace it with a launcher that picks the
	# Wayland backend when appropriate and honors a user flags file.
	vinstall "${FILESDIR}/claude-desktop.sh" 755 usr/bin claude-desktop

	vinstall share/applications/com.anthropic.Claude.desktop 644 usr/share/applications

	for size in 16 32 48 128 256; do
		vinstall "share/icons/hicolor/${size}x${size}/apps/claude-desktop.png" 644 \
			"usr/share/icons/hicolor/${size}x${size}/apps"
	done

	vlicense share/doc/claude-desktop/copyright LICENSE

	# --- Cowork VM compatibility shims ---------------------------------
	# The Cowork sandbox feature hardcodes Debian's filesystem paths for
	# its QEMU/virtiofsd/OVMF stack; map them to where Void installs them.
	#
	# virtiofsd: Void ships it in /usr/libexec, the app looks in /usr/bin.
	vmkdir usr/bin
	ln -sfr "${DESTDIR}/usr/libexec/virtiofsd" "${DESTDIR}/usr/bin/virtiofsd"

	# UEFI firmware (x86_64 only): the app opens
	# /usr/share/edk2/OVMF_CODE_4M.fd and OVMF_VARS_4M.fd (Debian naming).
	# edk2-ovmf installs them as usr/share/edk2/x64/OVMF_CODE.4m.fd and
	# OVMF_VARS.4m.fd; add compatibility symlinks under the same directory.
	# aarch64 needs no shim: the app opens /usr/share/AAVMF/AAVMF_CODE.fd,
	# which edk2-ovmf already provides at exactly that path.
	if [ "$XBPS_TARGET_MACHINE" = x86_64 ]; then
		vmkdir usr/share/edk2
		ln -sfr "${DESTDIR}/usr/share/edk2/x64/OVMF_CODE.4m.fd" \
			"${DESTDIR}/usr/share/edk2/OVMF_CODE_4M.fd"
		ln -sfr "${DESTDIR}/usr/share/edk2/x64/OVMF_VARS.4m.fd" \
			"${DESTDIR}/usr/share/edk2/OVMF_VARS_4M.fd"
	fi
}
