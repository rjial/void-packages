# Template file for 'sfwbar'
pkgname=sfwbar
# Tag upstream "v1.0_beta17" — underscore DITOLAK xbps-src di field version=
# ("version contains invalid character: _", diverifikasi langsung saat build).
# Diganti titik; distfiles di bawah tetap pakai nama tag asli apa adanya.
version=1.0.beta17
revision=1
build_style=meson
# mpd/bsdctl/bluez/iwd dimatikan eksplisit: config/sfwbar/sfwbar.config di
# dotfiles repo ini TIDAK pakai widget native mpd/bluez/iwd sama sekali (cmus
# dibaca lewat scanner kustom, bukan modul mpd bawaan). nm (NetworkManager)
# dibiarkan 'auto' krn mesin ini pakai NetworkManager.
configure_args="-Dmpd=disabled -Dbsdctl=disabled -Dbluez=disabled -Diwd=disabled"
hostmakedepends="pkg-config wayland-devel"
makedepends="gtk+3-devel glib-devel json-c-devel gtk-layer-shell-devel
 wayland-devel wayland-protocols pulseaudio-devel libxkbcommon-devel
 alsa-lib-devel pipewire-devel"
short_desc="Dynamic, highly configurable Wayland taskbar/panel"
