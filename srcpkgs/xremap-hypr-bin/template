do_install() {
	# Dipasang sbg xremap-hypr (BUKAN xremap polos) supaya bisa berdampingan dgn
	# xremap-gnome-bin yang sudah terpasang untuk sesi GNOME — keduanya menyalin
	# binary bernama sama ("xremap") dari rilis upstream, jadi kalau dua-duanya
	# dipasang sbg /usr/bin/xremap, xbps menolak install (file sudah dimiliki
	# paket lain). Konsekuensi: config/hypr/hyprland.lua HARUS memanggil
	# "xremap-hypr", bukan "xremap" polos.
	vbin xremap xremap-hypr
	vlicense "xremap-${version}-LICENSE.txt" LICENSE
}
