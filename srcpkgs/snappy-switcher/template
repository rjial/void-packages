# Tak ada tag rilis upstream (dipin ke commit tertentu via ${_commit}) dan tak
# ada file LICENSE di repo walau README mengklaim GPL-3.0 — tak ada yg di-vlicense.

# Upstream Makefile TIDAK menghormati $DESTDIR sama sekali (semua path instal
# langsung pakai $(PREFIX) literal, dan SYSCONFDIR malah hardcode absolut
# "/etc/xdg/snappy-switcher" tanpa $(PREFIX) sama sekali) — build_style=
# gnu-makefile bawaan xbps-src TIDAK bisa dipakai apa adanya (ia akan menulis
# ke /etc/xdg/snappy-switcher ASLI di masterdir chroot, bukan ke destdir).
# do_build/do_install manual, override PREFIX *dan* SYSCONFDIR supaya
# semuanya kena tanam ke bawah $DESTDIR.
do_build() {
	make ${makejobs}
}
do_install() {
	make PREFIX="${DESTDIR}/usr" \
	     SYSCONFDIR="${DESTDIR}/etc/xdg/snappy-switcher" \
	     install
}
