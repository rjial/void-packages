# Template file for 'helium-bin'
pkgname=helium-bin
version=0.18.1.1
revision=1
archs="x86_64 aarch64"
depends="xdg-utils liberation-fonts-ttf libpulseaudio libva libXScrnSaver
 hicolor-icon-theme desktop-file-utils"
short_desc="Private, fast, and honest web browser based on Chromium"
maintainer="Rizal Abdul Basith <rizalabdulbasith@maxxitani.id>"
license="GPL-3.0-only, BSD-3-Clause"
homepage="https://github.com/imputnet/helium-linux"
changelog="https://github.com/imputnet/helium-linux/releases"
nostrip=yes
noshlibprovides=yes
# these are optional Qt-theme integration shims, dlopen'd only if the
# corresponding Qt libs are already present; without this they'd drag
# in the whole Qt5 and Qt6 stacks as hard, non-optional dependencies
skiprdeps="/opt/helium/libqt5_shim.so /opt/helium/libqt6_shim.so"

case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-bin_${version}-1_amd64.deb
	 https://raw.githubusercontent.com/imputnet/helium-linux/${version}/LICENSE.ungoogled_chromium>helium-${version}-LICENSE.ungoogled_chromium.txt"
	checksum="c85c270cc5eca756c1a48fab2c4d414b83345c5a7e4b78601e1decdb3ed84805
	 9539b394e4179952698894bd62ef6566b6804ab0ff360dcf3a511cfaf7f78c4d"
	;;
aarch64)
	distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-bin_${version}-1_arm64.deb
	 https://raw.githubusercontent.com/imputnet/helium-linux/${version}/LICENSE.ungoogled_chromium>helium-${version}-LICENSE.ungoogled_chromium.txt"
	checksum="be4864c293b0374415568749562acefbd93a653185af51fdbd1b25789360cc2c
	 9539b394e4179952698894bd62ef6566b6804ab0ff360dcf3a511cfaf7f78c4d"
	;;
esac

do_install() {
	# trim upstream's size: the standalone WebDriver automation tool,
	# every locale but English, the software Vulkan fallback, and
	# 200%-scale UI assets aren't needed for a typical desktop install
	rm -f opt/helium/chromedriver
	find opt/helium/locales -type f ! -name en-US.pak -delete
	rm -f opt/helium/libvk_swiftshader.so opt/helium/vk_swiftshader_icd.json
	rm -f opt/helium/chrome_200_percent.pak

	vcopy opt /
	vcopy usr /

	# usr/bin/helium is a symlink to opt/helium/helium-wrapper (the
	# bundled wrapper); remove it before installing ours so vinstall
	# doesn't write through the symlink into the bundled file
	rm -f "${DESTDIR}/usr/bin/helium"
	vinstall "${FILESDIR}/helium.sh" 755 usr/bin helium

	vlicense "helium-${version}-LICENSE.ungoogled_chromium.txt" LICENSE.ungoogled_chromium
}
