# Template file for 'opencode-desktop-bin'
pkgname=opencode-desktop-bin
version=2.0.18
revision=1
archs="x86_64 aarch64"
depends="gtk+3 libnotify nss libXScrnSaver libXtst xdg-utils at-spi2-core
 libuuid libsecret hicolor-icon-theme desktop-file-utils"
short_desc="Desktop client for the OpenCode AI coding agent (official binary)"
maintainer="Rizal Abdul Basith <rizalabdulbasith@maxxitani.id>"
license="MIT"
homepage="https://opencode.ai"
changelog="https://github.com/anomalyco/opencode/releases"
nopie=yes
nostrip=yes
noshlibprovides=yes

case "$XBPS_TARGET_MACHINE" in
x86_64)
	distfiles="https://opencode.ai/files/bin/${version}/opencode-desktop-linux-amd64.deb
	 https://raw.githubusercontent.com/anomalyco/opencode/v${version}/LICENSE>opencode-desktop-${version}-LICENSE.txt"
	checksum=4f7605b762271b4abf61e8b301f59ddf3666f4acef3886ead323a3b5de35ca50
	;;
aarch64)
	distfiles="https://opencode.ai/files/bin/${version}/opencode-desktop-linux-arm64.deb
	 https://raw.githubusercontent.com/anomalyco/opencode/v${version}/LICENSE>opencode-desktop-${version}-LICENSE.txt"
	checksum=9ab6ce5cd5fe2ec41741e362d9f0c2c06b0e32cc97e58545e13c102d6e16f679
	;;
esac

do_install() {
	vmkdir usr/lib/opencode-desktop-bin
	vcopy 'opt/OpenCode/*' usr/lib/opencode-desktop-bin

	# Debian/Ubuntu packaging cruft, irrelevant on Void
	rm -f "${DESTDIR}/usr/lib/opencode-desktop-bin/resources/apparmor-profile"
	rm -f "${DESTDIR}/usr/lib/opencode-desktop-bin/resources/app-update.yml"

	vmkdir usr/bin
	ln -sfr "${DESTDIR}/usr/lib/opencode-desktop-bin/ai.opencode.desktop" \
		"${DESTDIR}/usr/bin/opencode-desktop"

	vinstall usr/share/applications/ai.opencode.desktop.desktop 644 \
		usr/share/applications opencode-desktop.desktop
	vsed -e "s|^Exec=.*|Exec=opencode-desktop %U|" \
	     -e "s|^Icon=.*|Icon=opencode-desktop|" \
	     -i "${DESTDIR}/usr/share/applications/opencode-desktop.desktop"

	local size
	for size in 32 64 128; do
		vinstall "usr/share/icons/hicolor/${size}x${size}/apps/ai.opencode.desktop.png" 644 \
			"usr/share/icons/hicolor/${size}x${size}/apps" opencode-desktop.png
	done

	vlicense "opencode-desktop-${version}-LICENSE.txt" LICENSE
}
